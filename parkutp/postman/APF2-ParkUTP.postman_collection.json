{
  "info": {
    "name": "APF2-ParkUTP",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    {
      "key": "baseUrl",
      "value": "http://localhost:8081"
    }
  ],
  "item": [
    {
      "name": "01 Crear sede de prueba",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "url": "{{baseUrl}}/api/sedes",
        "body": {
          "mode": "raw",
          "raw": "{\"id\": \"{{sedeId}}\", \"nombre\": \"Sede demo {{sedeId}}\"}",
          "options": {
            "raw": {
              "language": "json"
            }
          }
        }
      },
      "event": [
        {
          "listen": "prerequest",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.collectionVariables.set(\"sedeId\", \"DEMO-\" + Date.now());"
            ]
          }
        },
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test(\"HTTP 201\", () => pm.response.to.have.status(201));"
            ]
          }
        }
      ]
    },
    {
      "name": "02 Crear estacionamiento",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "url": "{{baseUrl}}/api/estacionamientos",
        "body": {
          "mode": "raw",
          "raw": "{\"sedeId\": \"{{sedeId}}\", \"nombre\": \"Zona demo\", \"capacidad\": 2, \"activo\": true}",
          "options": {
            "raw": {
              "language": "json"
            }
          }
        }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test(\"HTTP 201\", () => pm.response.to.have.status(201));",
              "pm.collectionVariables.set(\"parkingId\",pm.response.json().id);"
            ]
          }
        }
      ]
    },
    {
      "name": "03 Leer estacionamiento",
      "request": {
        "method": "GET",
        "header": [],
        "url": "{{baseUrl}}/api/estacionamientos/{{parkingId}}"
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test(\"HTTP 200\", () => pm.response.to.have.status(200));"
            ]
          }
        }
      ]
    },
    {
      "name": "04 Capacidad inválida",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "url": "{{baseUrl}}/api/estacionamientos",
        "body": {
          "mode": "raw",
          "raw": "{\"sedeId\": \"{{sedeId}}\", \"nombre\": \"Inválido\", \"capacidad\": 0}",
          "options": {
            "raw": {
              "language": "json"
            }
          }
        }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test(\"HTTP 400\", () => pm.response.to.have.status(400));"
            ]
          }
        }
      ]
    },
    {
      "name": "05 Actualizar estacionamiento",
      "request": {
        "method": "PUT",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "url": "{{baseUrl}}/api/estacionamientos/{{parkingId}}",
        "body": {
          "mode": "raw",
          "raw": "{\"sedeId\": \"{{sedeId}}\", \"nombre\": \"Zona renovada\", \"capacidad\": 1, \"activo\": true}",
          "options": {
            "raw": {
              "language": "json"
            }
          }
        }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test(\"HTTP 200\", () => pm.response.to.have.status(200));"
            ]
          }
        }
      ]
    },
    {
      "name": "06 Entrada simulada",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "url": "{{baseUrl}}/api/estacionamientos/{{parkingId}}/movimientos",
        "body": {
          "mode": "raw",
          "raw": "{\"eventoId\": \"{{eventoEntrada}}\", \"tipo\": \"ENTRADA\", \"origen\": \"SIMULADOR\", \"placa\": null}",
          "options": {
            "raw": {
              "language": "json"
            }
          }
        }
      },
      "event": [
        {
          "listen": "prerequest",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.collectionVariables.set(\"eventoEntrada\",pm.variables.replaceIn(\"{{$guid}}\"));"
            ]
          }
        },
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test(\"HTTP 200\", () => pm.response.to.have.status(200));",
              "pm.collectionVariables.set(\"movimientoId\",pm.response.json().id);"
            ]
          }
        }
      ]
    },
    {
      "name": "07 Reenviar mismo evento",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "url": "{{baseUrl}}/api/estacionamientos/{{parkingId}}/movimientos",
        "body": {
          "mode": "raw",
          "raw": "{\"eventoId\": \"{{eventoEntrada}}\", \"tipo\": \"ENTRADA\", \"origen\": \"SIMULADOR\", \"placa\": null}",
          "options": {
            "raw": {
              "language": "json"
            }
          }
        }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test(\"HTTP 200\", () => pm.response.to.have.status(200));",
              "pm.test(\"Mismo movimiento\",()=>pm.expect(pm.response.json().id).to.eql(Number(pm.collectionVariables.get(\"movimientoId\"))));"
            ]
          }
        }
      ]
    },
    {
      "name": "08 Aforo lleno",
      "request": {
        "method": "GET",
        "header": [],
        "url": "{{baseUrl}}/api/estacionamientos/{{parkingId}}"
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test(\"HTTP 200\", () => pm.response.to.have.status(200));",
              "pm.test(\"Un solo vehículo\",()=>pm.expect(pm.response.json().ocupados).to.eql(1));"
            ]
          }
        }
      ]
    },
    {
      "name": "09 Rechazar entrada con lleno",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "url": "{{baseUrl}}/api/estacionamientos/{{parkingId}}/movimientos",
        "body": {
          "mode": "raw",
          "raw": "{\"eventoId\": \"{{$guid}}\", \"tipo\": \"ENTRADA\", \"origen\": \"SIMULADOR\", \"placa\": null}",
          "options": {
            "raw": {
              "language": "json"
            }
          }
        }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test(\"HTTP 409\", () => pm.response.to.have.status(409));"
            ]
          }
        }
      ]
    },
    {
      "name": "10 Salida simulada",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "url": "{{baseUrl}}/api/estacionamientos/{{parkingId}}/movimientos",
        "body": {
          "mode": "raw",
          "raw": "{\"eventoId\": \"{{$guid}}\", \"tipo\": \"SALIDA\", \"origen\": \"SIMULADOR\", \"placa\": null}",
          "options": {
            "raw": {
              "language": "json"
            }
          }
        }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test(\"HTTP 200\", () => pm.response.to.have.status(200));"
            ]
          }
        }
      ]
    },
    {
      "name": "11 Aforo libre",
      "request": {
        "method": "GET",
        "header": [],
        "url": "{{baseUrl}}/api/estacionamientos/{{parkingId}}"
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test(\"HTTP 200\", () => pm.response.to.have.status(200));",
              "pm.test(\"Disponible\",()=>pm.expect(pm.response.json().disponibles).to.eql(1));"
            ]
          }
        }
      ]
    },
    {
      "name": "12 Conservar historial",
      "request": {
        "method": "DELETE",
        "header": [],
        "url": "{{baseUrl}}/api/estacionamientos/{{parkingId}}"
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test(\"HTTP 409\", () => pm.response.to.have.status(409));"
            ]
          }
        }
      ]
    },
    {
      "name": "13 Crear zona temporal",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "url": "{{baseUrl}}/api/estacionamientos",
        "body": {
          "mode": "raw",
          "raw": "{\"sedeId\": \"{{sedeId}}\", \"nombre\": \"Zona temporal\", \"capacidad\": 5}",
          "options": {
            "raw": {
              "language": "json"
            }
          }
        }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test(\"HTTP 201\", () => pm.response.to.have.status(201));",
              "pm.collectionVariables.set(\"temporalId\",pm.response.json().id);"
            ]
          }
        }
      ]
    },
    {
      "name": "14 Eliminar zona sin historial",
      "request": {
        "method": "DELETE",
        "header": [],
        "url": "{{baseUrl}}/api/estacionamientos/{{temporalId}}"
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test(\"HTTP 204\", () => pm.response.to.have.status(204));"
            ]
          }
        }
      ]
    },
    {
      "name": "15 Consultar zona eliminada",
      "request": {
        "method": "GET",
        "header": [],
        "url": "{{baseUrl}}/api/estacionamientos/{{temporalId}}"
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test(\"HTTP 404\", () => pm.response.to.have.status(404));"
            ]
          }
        }
      ]
    }
  ]
}
